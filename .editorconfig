# EditorConfig helps maintain consistent coding styles across editors and AI tools.
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Default indentation
indent_style = space
indent_size = 2

# Python
[*.py]
indent_size = 4
max_line_length = 88

# Django templates / HTML
[*.{html,htm}]
indent_size = 2

# CSS / JS
[*.{css,js}]
indent_size = 2

# JSON / YAML / Markdown
[*.json]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 2

# Makefile requires tabs
[Makefile]
indent_style = tab